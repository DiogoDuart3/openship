{
  "available": true,
  "id": "uptime-kuma",
  "name": "Uptime Kuma",
  "description": "Self-hosted uptime monitoring with status pages and alerts.",
  "kind": "template",
  "logo": "uptime-kuma",
  "category": "other",
  "tags": [
    "monitoring",
    "uptime",
    "status"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "uptime-kuma",
      "image": "louislam/uptime-kuma:2-slim",
      "ports": [
        "3011:3001"
      ],
      "exposedPort": 3011,
      "exposed": true,
      "volumes": [
        "uptime_kuma_data:/app/data"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:3001/ >/dev/null 2>&1 || curl -fsS http://127.0.0.1:3001/ >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "20s"
      }
    }
  ]
}
