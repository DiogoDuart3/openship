{
  "available": true,
  "id": "code-server",
  "name": "code-server",
  "description": "Run VS Code in your browser, on your server. Login uses an auto-generated password.",
  "kind": "template",
  "logo": "code-server",
  "category": "other",
  "tags": [
    "developer",
    "ide",
    "vscode"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "code-server",
      "image": "codercom/code-server:4.131.0",
      "ports": [
        "8080:8080"
      ],
      "exposedPort": 8080,
      "exposed": true,
      "secretEnv": [
        "PASSWORD"
      ],
      "volumes": [
        "code_server_home:/home/coder"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || curl -fsS http://127.0.0.1:8080/ >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "20s"
      }
    }
  ],
  "configFields": [
    {
      "key": "PASSWORD",
      "service": "code-server",
      "label": "Login password",
      "help": "Auto-generated. Required to sign in.",
      "generate": "secret",
      "secret": true
    }
  ]
}
