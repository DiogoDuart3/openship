{
  "available": true,
  "id": "nocodb",
  "name": "NocoDB",
  "description": "Airtable-style spreadsheet UI over an SQL database. The first sign-up becomes the admin.",
  "kind": "template",
  "logo": "nocodb",
  "category": "database",
  "tags": [
    "database",
    "airtable",
    "no-code"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "nocodb",
      "image": "nocodb/nocodb:2026.07.0",
      "ports": [
        "8080:8080"
      ],
      "exposedPort": 8080,
      "exposed": true,
      "volumes": [
        "nocodb_data:/usr/app/data"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || curl -fsS http://127.0.0.1:8080/ >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "20s"
      }
    }
  ]
}
