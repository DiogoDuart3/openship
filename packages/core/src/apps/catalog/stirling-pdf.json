{
  "available": true,
  "id": "stirling-pdf",
  "name": "Stirling PDF",
  "description": "Split, merge, convert, OCR and edit PDFs locally. Default login is admin / stirling \u2014 change it.",
  "kind": "template",
  "logo": "stirling-pdf",
  "category": "other",
  "tags": [
    "pdf",
    "documents",
    "tools"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "stirling-pdf",
      "image": "stirlingtools/stirling-pdf:2.14.2-ultra-lite",
      "ports": [
        "8080:8080"
      ],
      "exposedPort": 8080,
      "exposed": true,
      "volumes": [
        "stirling_config:/configs",
        "stirling_tessdata:/usr/share/tessdata"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || curl -fsS http://127.0.0.1:8080/ >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "30s"
      }
    }
  ]
}
