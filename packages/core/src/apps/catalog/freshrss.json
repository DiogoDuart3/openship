{
  "available": true,
  "id": "freshrss",
  "name": "FreshRSS",
  "description": "Self-hosted RSS and Atom feed reader with a first-run setup wizard.",
  "kind": "template",
  "logo": "freshrss",
  "category": "other",
  "tags": [
    "rss",
    "feeds",
    "reader"
  ],
  "framework": "docker-compose",
  "services": [
    {
      "name": "freshrss",
      "image": "freshrss/freshrss:1.29.1-alpine",
      "ports": [
        "8223:80"
      ],
      "exposedPort": 8223,
      "exposed": true,
      "volumes": [
        "freshrss_data:/var/www/FreshRSS/data"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:80/ >/dev/null 2>&1 || curl -fsS http://127.0.0.1:80/ >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "20s"
      }
    }
  ]
}
